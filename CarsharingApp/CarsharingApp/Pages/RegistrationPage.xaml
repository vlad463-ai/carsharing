<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsharingApp.Pages.RegistrationPage"
             Title="Регистрация">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Entry x:Name="LoginEntry" Placeholder="Логин" />
        <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True" />
        <Entry x:Name="FullNameEntry" Placeholder="ФИО" />
        <Entry x:Name="PhoneEntry" Placeholder="Телефон" Keyboard="Telephone" />
        <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
        <Button x:Name="RegisterButton" Text="Зарегистрироваться" Clicked="OnRegisterClicked" />
        <Label x:Name="ResultLabel" />
    </VerticalStackLayout>
</ContentPage>