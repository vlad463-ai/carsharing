<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsharingApp.Pages.TripsPage"
             Title="Мои поездки">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Button x:Name="RefreshButton" Text="Обновить" Clicked="OnRefreshClicked" />
        <Label x:Name="ResultLabel" />
        <CollectionView x:Name="TripsList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="10">
                        <VerticalStackLayout>
                            <Label Text="{Binding DisplayDate}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding DisplayDistance}" FontSize="14" />
                            <Label Text="{Binding DisplayCost}" FontSize="16" TextColor="Green" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>