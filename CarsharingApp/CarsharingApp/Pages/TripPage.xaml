<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsharingApp.Pages.TripPage"
             Title="Поездка">
    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Управление поездкой" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>

        <Button x:Name="StartTripBtn" Text="Начать поездку" Clicked="OnStartTripClicked" />
        <Button x:Name="FinishTripBtn" Text="Завершить поездку" Clicked="OnFinishTripClicked" IsEnabled="False" />

        <Label x:Name="StatusLabel" Text="Ожидание..." FontSize="16" />
        <Label x:Name="ResultLabel" TextColor="Green" FontSize="16" FontAttributes="Bold" />
    </VerticalStackLayout>
</ContentPage>