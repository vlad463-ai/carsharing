<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CarsharingApp.Pages.ReviewsPage" Title="Отзывы об автомобиле" >
    <Grid Padding="24" MaximumWidthRequest="800" HorizontalOptions="Fill">
        <CollectionView x:Name="ReviewsList" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="20" Padding="0,0,0,20">
                    <VerticalStackLayout Spacing="6"><Label Text="ВПЕЧАТЛЕНИЯ О ПОЕЗДКЕ" Style="{StaticResource Eyebrow}" /><Label Text="Отзывы об автомобиле" Style="{StaticResource PageTitle}" /><Label Text="Ваш опыт поможет другим выбрать автомобиль." Style="{StaticResource Muted}" /></VerticalStackLayout>
                    <Border Style="{StaticResource Panel}"><VerticalStackLayout Spacing="14">
                        <Label Text="Поделитесь впечатлениями" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout Spacing="6"><Label Text="Ваша оценка" Style="{StaticResource FieldLabel}" /><Picker x:Name="RatingPicker" Title="Выберите оценку"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>5 — Отлично</x:String><x:String>4 — Хорошо</x:String><x:String>3 — Нормально</x:String><x:String>2 — Ниже ожиданий</x:String><x:String>1 — Плохо</x:String></x:Array></Picker.ItemsSource></Picker></VerticalStackLayout>
                        <VerticalStackLayout Spacing="6"><Label Text="Комментарий" Style="{StaticResource FieldLabel}" /><Editor x:Name="CommentEditor" HeightRequest="100" Placeholder="Что вам понравилось? Что можно улучшить?" /></VerticalStackLayout>
                        <Button Text="Опубликовать отзыв" Clicked="OnAddReviewClicked" HorizontalOptions="Start" />
                    </VerticalStackLayout></Border>
                    <Label Text="Мнения водителей" Style="{StaticResource SectionTitle}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView><Label Text="Отзывов пока нет. Поделитесь первым впечатлением." Style="{StaticResource Muted}" Padding="8,20" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate><DataTemplate>
                <Border Padding="22" Margin="0,0,0,12"><VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding DisplayStars}" FontSize="20" TextColor="{StaticResource RatingInk}" /><Label Grid.Column="1" Text="{Binding DisplayDate}" Style="{StaticResource Muted}" VerticalOptions="Center" /></Grid>
                    <Label Text="{Binding Comment}" LineBreakMode="WordWrap" />
                </VerticalStackLayout></Border>
            </DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
