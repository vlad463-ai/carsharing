<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsharingApp.Pages.ReviewsPage"
             Title="Отзывы">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Оставить отзыв" FontSize="18" FontAttributes="Bold" />

            <Label Text="Оценка:" />
            <Picker x:Name="RatingPicker">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>5 ★</x:String>
                        <x:String>4 ★</x:String>
                        <x:String>3 ★</x:String>
                        <x:String>2 ★</x:String>
                        <x:String>1 ★</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Комментарий:" />
            <Editor x:Name="CommentEditor" HeightRequest="80" Placeholder="Напишите отзыв..." />

            <Button Text="Отправить" Clicked="OnAddReviewClicked" />

            <Label Text="Все отзывы:" FontSize="18" FontAttributes="Bold" Margin="0,20,0,0" />

            <CollectionView x:Name="ReviewsList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="10">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="{Binding DisplayStars}" FontSize="18" TextColor="Gold" />
                                    <Label Grid.Column="1" Text="{Binding DisplayDate}" FontSize="12" TextColor="Gray" />
                                </Grid>
                                <Label Text="{Binding Comment}" FontSize="14" Margin="0,5,0,0" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>