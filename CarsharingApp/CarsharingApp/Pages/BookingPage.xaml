<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CarsharingApp.Pages.BookingPage" Title="Бронирование" >
    <ScrollView><Grid Padding="24" VerticalOptions="Center">
        <VerticalStackLayout MaximumWidthRequest="600" Spacing="20" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="6">
                <Label Text="ПЛАНИРУЙТЕ ПОЕЗДКУ" Style="{StaticResource Eyebrow}" />
                <Label Text="Автомобиль будет ждать" Style="{StaticResource PageTitle}" />
                <Label Text="Укажите начало и окончание бронирования." Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Panel}"><VerticalStackLayout Spacing="16">

<Label Text="Начало бронирования" Style="{StaticResource SectionTitle}" />
<VerticalStackLayout Spacing="6"><Label Text="Дата" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="StartDatePicker" /></VerticalStackLayout>
<VerticalStackLayout Spacing="6"><Label Text="Время" Style="{StaticResource FieldLabel}" /><TimePicker x:Name="StartTimePicker" /></VerticalStackLayout>
<BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />
<Label Text="Окончание бронирования" Style="{StaticResource SectionTitle}" />
<VerticalStackLayout Spacing="6"><Label Text="Дата" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="EndDatePicker" /></VerticalStackLayout>
<VerticalStackLayout Spacing="6"><Label Text="Время" Style="{StaticResource FieldLabel}" /><TimePicker x:Name="EndTimePicker" /></VerticalStackLayout>
<Label x:Name="ResultLabel" TextColor="#AD3E32" LineBreakMode="WordWrap" />
<Button x:Name="BookButton" Text="Подтвердить бронирование" Clicked="OnBookClicked" />
            </VerticalStackLayout></Border>
        </VerticalStackLayout>
    </Grid></ScrollView>
</ContentPage>
